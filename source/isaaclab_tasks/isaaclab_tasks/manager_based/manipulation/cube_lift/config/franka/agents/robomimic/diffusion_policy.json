{
    "algo_name": "diffusion_policy",
    "experiment": {
        "name": "diffusion_policy_adjusted_new",
        "validate": true,
        "logging": {
            "terminal_output_to_txt": true,
            "log_tb": true,
            "log_wandb": true,
            "wandb_proj_name": "pick_place_diffusion_vision"
        },
        "save": {
            "enabled": true,
            "every_n_seconds": null,
            "every_n_epochs": 50,
            "epochs": [],
            "on_best_validation": true,
            "on_best_rollout_return": false,
            "on_best_rollout_success_rate": false
        },
        "epoch_every_n_steps": 100,
        "validation_epoch_every_n_steps": 10,
        "env": "Dev-IK-Rel-Place-vision-v0",
        "additional_envs": null,
        "render": false,
        "render_video": false,
        "keep_all_videos": false,
        "video_skip": 5,
        "rollout": {
            "enabled": false,
            "terminate_on_success": true,
            "n": 10,
            "horizon": 500,
            "rate": 50
        }
    },
    "train": {
        "data": null,
        "output_dir": "docs/training_runs/diffusion_policy_vision",
        "num_data_workers": 4,
        "hdf5_cache_mode": "low_dim",
        "hdf5_use_swmr": true,
        "hdf5_normalize_obs": false,
        "hdf5_filter_key": "train",
        "hdf5_validation_filter_key": "valid",
        "seq_length": 64,
        "pad_seq_length": true,
        "frame_stack": 1,
        "pad_frame_stack": true,
        "goal_mode": null,
        "dataset_keys": [
            "actions",
            "rewards",
            "dones"
        ],
        "action_keys": [
            "actions"
        ],
        "cuda": true,
        "batch_size": 64,
        "num_epochs": 200,
        "seed": 101
    },
    "algo": {
        "optim_params": {
            "policy": {
                "optimizer_type": "adamw",
                "learning_rate": {
                    "initial": 0.0001,
                    "decay_factor": 0.01,
                    "epoch_schedule": [],
                    "scheduler_type": "cosine",
                    "step_every_batch": true,
                    "warmup_steps": 500,
                    "num_cycles": 0.5
                },
                "regularization": {
                    "L2": 0.001
                }
            }
        },
        "horizon": {
            "observation_horizon": 2,
            "action_horizon": 16,
            "prediction_horizon": 64
        },
        "unet": {
            "enabled": true,
            "diffusion_step_embed_dim": 256,
            "down_dims": [
                256,
                512,
                1024
            ],
            "kernel_size": 5,
            "n_groups": 8
        },
        "ema": {
            "enabled": true,
            "power": 0.999
        },
        "ddpm": {
            "enabled": false,
            "num_train_timesteps": 100,
            "num_inference_timesteps": 100,
            "beta_schedule": "squaredcos_cap_v2",
            "clip_sample": true,
            "prediction_type": "epsilon"
        },
        "ddim": {
            "enabled": true,
            "num_train_timesteps": 100,
            "num_inference_timesteps": 16,
            "beta_schedule": "squaredcos_cap_v2",
            "clip_sample": true,
            "set_alpha_to_one": true,
            "steps_offset": 0,
            "prediction_type": "epsilon"
        }
    },
    "observation": {
        "modalities": {
            "obs": {
                "low_dim": [
                    "eef_pos",
                    "eef_quat",
                    "gripper_pos",
                    "object_position",
                    "target_object_position"
                ],
                "rgb": [
                    "table_cam",
                    "wrist_cam"
                ],
                "depth": [],
                "scan": []
            }
        },
        "encoder": {
            "low_dim": {
                "core_class": null,
                "core_kwargs": {},
                "obs_randomizer_class": null,
                "obs_randomizer_kwargs": {}
            },
            "rgb": {
                "core_class": "VisualCore",
                "core_kwargs": {
                    "feature_dimension": 64,
                    "backbone_class": "ResNet18Conv",
                    "backbone_kwargs": {
                        "pretrained": true,
                        "input_coord_conv": true
                    },
                    "pool_class": "SpatialSoftmax",
                    "pool_kwargs": {
                        "num_kp": 32,
                        "learnable_temperature": false,
                        "temperature": 1.0,
                        "noise_std": 0.0
                    }
                },
                "obs_randomizer_class": "CropRandomizer",
                "obs_randomizer_kwargs": {
                    "crop_height": 128,
                    "crop_width": 128,
                    "num_crops": 1,
                    "pos_enc": false
                }
            }
        }
    }
}